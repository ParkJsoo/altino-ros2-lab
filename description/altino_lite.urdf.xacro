<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="altino_lite">
  <!-- Approximate pre-sensor model for TF/RViz bring-up. Measure and update
       dimensions when permanent sensor mounts are installed. -->
  <xacro:property name="body_length" value="0.180"/>
  <xacro:property name="body_width" value="0.105"/>
  <xacro:property name="body_height" value="0.055"/>
  <xacro:property name="base_z" value="0.030"/>
  <xacro:property name="wheel_base" value="0.120"/>
  <xacro:property name="track_width" value="0.090"/>
  <xacro:property name="wheel_radius" value="0.018"/>
  <xacro:property name="wheel_width" value="0.012"/>
  <xacro:arg name="include_sensor_placeholders" default="false"/>

  <material name="altino_red">
    <color rgba="0.8 0.02 0.02 1.0"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="sensor_blue">
    <color rgba="0.0 0.2 0.8 0.8"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="altino_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${body_height / 2.0}" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.03"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="front_left_wheel" x="${wheel_base / 2.0}" y="${track_width / 2.0}"/>
  <xacro:wheel name="front_right_wheel" x="${wheel_base / 2.0}" y="${-track_width / 2.0}"/>
  <xacro:wheel name="rear_left_wheel" x="${-wheel_base / 2.0}" y="${track_width / 2.0}"/>
  <xacro:wheel name="rear_right_wheel" x="${-wheel_base / 2.0}" y="${-track_width / 2.0}"/>

  <xacro:if value="$(arg include_sensor_placeholders)">
    <link name="imu_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.018 0.006"/>
        </geometry>
        <material name="sensor_blue"/>
      </visual>
    </link>
    <joint name="base_link_to_imu_link" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="0 0 ${body_height + 0.004}" rpy="0 0 0"/>
    </joint>

    <link name="range_front_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.012 0.045 0.018"/>
        </geometry>
        <material name="sensor_blue"/>
      </visual>
    </link>
    <joint name="base_link_to_range_front_link" type="fixed">
      <parent link="base_link"/>
      <child link="range_front_link"/>
      <origin xyz="${body_length / 2.0 + 0.006} 0 ${body_height * 0.65}" rpy="0 0 0"/>
    </joint>

    <link name="laser_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.025" length="0.018"/>
        </geometry>
        <material name="sensor_blue"/>
      </visual>
    </link>
    <joint name="base_link_to_laser_link" type="fixed">
      <parent link="base_link"/>
      <child link="laser_link"/>
      <origin xyz="0.025 0 ${body_height + 0.018}" rpy="0 0 0"/>
    </joint>
  </xacro:if>
</robot>
